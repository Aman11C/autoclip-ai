# AutoClip AI — Backend Environment Configuration

# Database (defaults to SQLite if unset)
DATABASE_URL=sqlite:///./autoclip.db

# AI Viral Moment Detection & Transcription (Optional: app falls back gracefully to local heuristic NLP if unset)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# FFmpeg Executable Override (optional - bundled static ffmpeg will be used if unset)
# FFMPEG_PATH=/usr/bin/ffmpeg
