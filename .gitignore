# AutoClip AI .gitignore

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build and cache
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Database
*.db
*.sqlite
*.sqlite3

# Binaries (FFmpeg binaries - install via package manager or run setup)
bin/*.exe
!bin/.gitkeep

# Media, Transcodes, and Temporary files
backend/static/clips/*
!backend/static/clips/.gitkeep
backend/static/projects/*
!backend/static/projects/.gitkeep
backend/static/thumbnails/*
!backend/static/thumbnails/.gitkeep
*.mp4
*.part
*.webm
*.avi
*.mov

# Environment variables & local credentials
.env
.env.local
.env.*.local
*.log

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
